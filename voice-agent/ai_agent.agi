#!/bin/bash

LOG=/var/log/asterisk/ai_agent.log
exec 2>>"$LOG"
echo "=== call start $(date) ===" >>"$LOG"

CALLERID=""
CALLERIDNAME=""
AGICHANNEL=""
while read -r line; do
    [ -z "$line" ] && break
    case "$line" in
        agi_callerid=*) CALLERID="${line#agi_callerid=}" ;;
        agi_calleridname=*) CALLERIDNAME="${line#agi_calleridname=}" ;;
        agi_channel=*) AGICHANNEL="${line#agi_channel=}" ;;
    esac
done
echo "callerid=$CALLERID name=$CALLERIDNAME channel=$AGICHANNEL" >>"$LOG"

PREFIX=0
if [[ "$AGICHANNEL" =~ ^PJSIP/([0-9]+)- ]]; then
    PREFIX="${BASH_REMATCH[1]}"
elif [[ "$CALLERID" =~ ^[0-9]+$ ]]; then
    PREFIX="$CALLERID"
elif [ -n "$CALLERIDNAME" ] && [ "$CALLERIDNAME" != "unknown" ]; then
    PREFIX="$(echo "$CALLERIDNAME" | tr " " "-" | tr -cd "[:alnum:]_-")"
fi

SESS="/opt/voice-agent/sessions/${PREFIX}-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$SESS"
HISTORY="$SESS/history.json"
echo '[]' > "$HISTORY"
echo "session=$SESS" >>"$LOG"

agi_cmd() {
    printf "%s\n" "$1"
    IFS= read -r AGI_RESP
    echo "[AGI] $1 => $AGI_RESP" >>"$LOG"
}

MAXTURNS=12
TURN=0
SILENT=0

while [ "$TURN" -lt "$MAXTURNS" ]; do
    TURN=$((TURN+1))
    BASE="$SESS/turn${TURN}"

    agi_cmd "RECORD FILE $BASE.raw ulaw \"\" 6000 0 s=0.9"

    if [ ! -f "$BASE.raw.ulaw" ]; then
        echo "no recording (hangup?) turn=$TURN" >>"$LOG"
        break
    fi

    sox -t raw -r 8000 -c 1 -e mu-law "$BASE.raw.ulaw" "$BASE.wav" >>"$LOG" 2>&1
    if [ ! -f "$BASE.wav" ]; then
        echo "no wav turn=$TURN" >>"$LOG"
        break
    fi

    sox "$BASE.wav" "$BASE.trim.wav" silence -l 1 0.05 2% silence -l 1 0.25 2% >>"$LOG" 2>&1
    DUR=$(sox "$BASE.trim.wav" -n stat 2>&1 | awk '/^Length/{print $NF}')
    TOOSHORT=$(python3 -c "import sys; print(1 if not sys.argv[1] or float(sys.argv[1]) < 0.4 else 0)" "$DUR" 2>/dev/null || echo 1)
    if [ "$TOOSHORT" = "1" ]; then
        SILENT=$((SILENT+1))
        TURN=$((TURN-1))
        echo "silent turn=$TURN dur=$DUR silent=$SILENT" >>"$LOG"
        if [ "$SILENT" -ge 18 ]; then
            echo "too much silence ($SILENT), ending call" >>"$LOG"
            break
        fi
        continue
    fi
    SILENT=0
    cp "$BASE.trim.wav" "$BASE.wav"

    HISTORY_DATA=$(cat "$HISTORY")
    PAYLOAD=$(python3 -c '
import sys, json
print(json.dumps({
    "audio_path": sys.argv[1],
    "caller_id": sys.argv[2],
    "caller_name": sys.argv[3],
    "session_id": sys.argv[4],
    "history": json.loads(sys.argv[5]),
}))
' "$BASE.wav" "$CALLERID" "$CALLERIDNAME" "$SESS" "$HISTORY_DATA")
    echo "payload turn=$TURN at $(date +%s.%N)" >>"$LOG"

    RESP=$(curl -s -m 120 -X POST http://127.0.0.1:5678/webhook/hotline \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD")
    echo "webhook resp at $(date +%s.%N): $RESP" >>"$LOG"

    REPLY_TEXT=$(echo "$RESP" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get("reply_text", ""))
except Exception:
    print("")
' 2>/dev/null)
    NEEDS_HUMAN=$(echo "$RESP" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    print("true" if d.get("needs_human") else "false")
except Exception:
    print("false")
' 2>/dev/null)
    NEWHISTORY=$(echo "$RESP" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    h = d.get("history")
    print(json.dumps(h) if isinstance(h, list) else "[]")
except Exception:
    print("[]")
' 2>/dev/null)

    [ "$NEWHISTORY" != "[]" ] && echo "$NEWHISTORY" > "$HISTORY"
    echo "reply_text=$REPLY_TEXT needs_human=$NEEDS_HUMAN turn=$TURN" >>"$LOG"

    if [ -n "$REPLY_TEXT" ]; then
        /opt/voice-agent/piper/start.sh
        REPLYWAV="$SESS/reply${TURN}.wav"
        REPLYJSON=$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1]}))' "$REPLY_TEXT")
        curl -s -m 20 -X POST http://127.0.0.1:5000/synthesize \
            -H "Content-Type: application/json" -d "$REPLYJSON" -o "$REPLYWAV"
        if [ -s "$REPLYWAV" ]; then
            REPLYPCM="${REPLYWAV%.wav}-pcm.wav"
            sox "$REPLYWAV" -t wav -r 8000 -c 1 -e signed-integer -b 16 "$REPLYPCM" >>"$LOG" 2>&1 || true
            if [ -f "$REPLYPCM" ]; then
                agi_cmd "EXEC Playback ${REPLYPCM%.wav}"
            fi
        fi
    fi

    if [ "$NEEDS_HUMAN" = "true" ]; then
        echo "needs_human true, ending turn=$TURN" >>"$LOG"
        break
    fi
done

agi_cmd "HANGUP"
echo "=== call end ===" >>"$LOG"
exit 0
