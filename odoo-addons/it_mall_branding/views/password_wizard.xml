<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="it_mall_password_wizard_form" model="ir.ui.view">
        <field name="name">it_mall.password.wizard.form</field>
        <field name="model">it_mall.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Set User Password">
                <group>
                    <field name="user_id"/>
                    <field name="new_password" password="True"/>
                    <field name="confirm_password" password="True"/>
                </group>
                <footer>
                    <button name="action_set_password" type="object" string="Set Password" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_it_mall_password_wizard" model="ir.actions.act_window">
        <field name="name">Set Password</field>
        <field name="res_model">it_mall.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
