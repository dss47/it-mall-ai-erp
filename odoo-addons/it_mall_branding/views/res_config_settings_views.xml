<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_it_mall_clean" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.it_mall_clean</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <!-- 1. Hide Developer Tools -->
            <xpath expr="//widget[@name='res_config_dev_tool']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- 2. Hide About section with QR codes and Odoo edition -->
            <xpath expr="//div[@id='about']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- 3. Hide Inter-company upsell -->
            <xpath expr="//setting[@id='inter_company']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- 4. Hide SMS IAP -->
            <xpath expr="//setting[@id='sms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
