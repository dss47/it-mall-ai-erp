<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_itmall" inherit_id="sale.report_saleorder_document" priority="20">
        <!-- 1. En-tête personnalisé et moderne IT Mall -->
        <xpath expr="//div[hasclass('page')]" position="before">
            <style>
                .itmall-header {
                    border-bottom: 2px solid #0284c7;
                    padding-bottom: 12px;
                    margin-bottom: 20px;
                }
                .itmall-title {
                    color: #0284c7;
                    font-weight: 700;
                    font-size: 24px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }
                .itmall-badge {
                    background-color: #0284c7;
                    color: white;
                    padding: 4px 10px;
                    border-radius: 6px;
                    font-size: 12px;
                    font-weight: 600;
                }
                .itmall-table th {
                    background-color: #0284c7 !important;
                    color: white !important;
                    text-transform: uppercase;
                    font-size: 11px;
                    padding: 8px 10px !important;
                    border: none !important;
                }
                .itmall-table td {
                    padding: 10px !important;
                    vertical-align: middle !important;
                    border-bottom: 1px solid #e2e8f0 !important;
                    color: #1e293b;
                }
                .itmall-total-box {
                    background-color: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 8px;
                    padding: 15px;
                }
                .itmall-total-price {
                    color: #0284c7;
                    font-size: 20px;
                    font-weight: 800;
                }
            </style>
        </xpath>

        <!-- 2. Styliser le tableau des articles -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class">table itmall-table table-sm o_main_table table-borderless</attribute>
        </xpath>

        <!-- 3. Signature et Bas de page professionnel -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="mt-4 pt-3 border-top d-flex justify-content-between text-muted" style="font-size: 11px;">
                <div>
                    <strong>IT Mall Maroc</strong> — 26 Avenue Mohammed V, Casablanca<br/>
                    Tél : +212 789 277 770 | E-mail : contact@itmall.ma | Web : www.itmall.ma
                </div>
                <div class="text-end">
                    Document généré électroniquement par le système IT Mall.<br/>
                    Valable pour une durée de 30 jours.
                </div>
            </div>
        </xpath>
    </template>
</odoo>
