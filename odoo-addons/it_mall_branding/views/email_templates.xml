<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- This changes "Powered by Odoo" to "Powered by IT Mall" in notification emails -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//div[contains(text(),'Powered by')]" position="replace">
            <div style="color: #555555; font-size:11px;">
                Powered by IT Mall
            </div>
        </xpath>
    </template>

    <!-- Same thing for the light email template -->
    <template id="mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//td[contains(.,'Powered by')]" position="replace">
            <td align="center" style="min-width: 590px;">
                Powered by IT Mall
            </td>
        </xpath>
    </template>

</odoo>